# ─────────────────────────────────────────────────────────────────────────────
# Gold Coast Hair API — Environment Variables
# Copy to .env and fill in values before running
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development              # development | test | production
PORT=3000                         # Railway injects this automatically
HOST=0.0.0.0                      # Must be 0.0.0.0 for Railway
API_PREFIX=/api/v1

# ─── Database ────────────────────────────────────────────────────────────────
# Railway Postgres: copy from Railway dashboard
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ─── Redis ───────────────────────────────────────────────────────────────────
# Railway Redis: use rediss:// (TLS) for production
REDIS_URL=redis://localhost:6379
# Production: REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins, or * for development
CORS_ORIGINS=https://goldcoasthair.com,https://www.goldcoasthair.com

# ─── Cloudinary (image uploads) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Paystack (payments) ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_your-paystack-secret-key
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100                # Requests per window
RATE_LIMIT_WINDOW_MS=60000        # Window in ms (60s default)

# ─── Security ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12                  # 10-12 recommended for production

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info                    # fatal | error | warn | info | debug | trace

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Gold Coast Hair API
